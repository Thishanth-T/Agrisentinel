; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="AgriSentinel Hardware Simulator"
config/description="Autonomous Parametric Crop Insurance & Cryptographic Anti-Fraud 2G Telemetry Simulator"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.0", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1150
window/size/viewport_height=700
window/stretch/mode="viewport"

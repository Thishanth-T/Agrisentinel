# ==============================================================================
# AGRISENTINEL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your own API keys.
# NEVER commit your actual .env file to public Git repositories!
# ==============================================================================

# Twilio Telephony Credentials (Optional - for 2G Regional Voice Dispatch)
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890
FARMER_TEST_PHONE=+919876543210

# Groq Cloud API Key (Optional - for dynamic LLaMA-3.3 agronomic recommendations)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# OpenWeatherMap API Key (Optional - for live meteorological cross-examination)
OPENWEATHER_API_KEY=YOUR_OPENWEATHERMAP_API_KEY_HERE

# Twilio Webhook Base URL (Optional - e.g., https://your-domain.ngrok-free.app)
TWILIO_VOICE_URL=
